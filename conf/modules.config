process {
    withName: 'BAITS_MAIN:NORMALIZE_CURATED_SOURCE_SEQUENCES' {
        publishDir = [
            path: { "${params.results}/artifacts/${meta.id}" },
            mode: 'copy',
            pattern: 'source_sequences.fasta',
        ]
    }

    withName: 'BAITS_MAIN:DISCOVER_SOURCE_SEQUENCES:EXTRACT_SOURCE_SEQUENCES' {
        publishDir = [
            path: { "${params.results}/artifacts/${meta.id}" },
            mode: 'copy',
            pattern: 'source_sequences.fasta',
        ]
    }

    withName: 'BAITS_MAIN:REPORT_SOURCE_DISCOVERY_RESULTS:REPORT_SOURCE_DISCOVERY' {
        publishDir = [
            path: { params.results },
            mode: 'copy',
            pattern: '{candidate_loci.tsv,source_matches.tsv.gz}',
        ]
    }

    withName: 'BAITS_MAIN:FILTER_CANDIDATE_KMERS:APPLY_COMPLEXITY_FILTER' {
        publishDir = [
            [
                path: { "${params.results}/artifacts/${meta.id}" },
                mode: 'copy',
                pattern: 'selected_candidates.fasta',
                saveAs: { params.taxon_ref_db ? null : 'baits.fasta' },
            ],
        ]
    }

    withName: 'REPORT_TAXONOMIC_MATCH_RESULTS:REPORT_TAXONOMIC_MATCHES' {
        publishDir = [
            path: { params.results },
            mode: 'copy',
            pattern: 'taxonomic_matches.tsv.gz',
        ]
    }

    withName: 'BAITS_MAIN:TAXONOMIC_EXACT_MATCH_SCREENING:BLASTN_TAXONOMIC_SCREENING' {
        publishDir = [
            path: { "${params.results}/${meta.id}/07_provenance" },
            mode: 'copy',
            pattern: 'taxonomic_reference_database.txt',
        ]
    }

    withName: 'BAITS_MAIN:TAXONOMIC_EXACT_MATCH_SCREENING:APPLY_TAXONOMIC_SCREENING' {
        publishDir = [
            [
                path: { "${params.results}/artifacts/${meta.id}" },
                mode: 'copy',
                pattern: 'selected_candidates.fasta',
                saveAs: { 'baits.fasta' },
            ],
        ]
    }

    withName: 'REPORT_CANDIDATE_KMER_RESULTS:REPORT_CANDIDATE_KMERS' {
        publishDir = [
            path: { params.results },
            mode: 'copy',
            pattern: '{candidate_kmers,candidate_kmer_occurrences}.tsv',
        ]
    }

    withName: /BAITS_MAIN:BUILD_VERIFY_DEACON_INDEX_(?:WITH|WITHOUT)_TAXONOMY:VERIFY_DEACON_INDEX/ {
        publishDir = [
            path: { "${params.results}/artifacts/${meta.id}" },
            mode: 'copy',
            pattern: 'verification_input/deacon.idx',
            saveAs: { 'deacon.idx' },
        ]
    }

    withName: 'REPORT_SHARED_CALIBRATION_RESULTS:REPORT_CALIBRATION_RESULTS' {
        publishDir = [
            path: { params.results },
            mode: 'copy',
            pattern: '{calibration_reads.tsv,calibration_matches.tsv.gz}',
        ]
    }

    withName: 'FIND_CONCATENATE' {
        ext.prefix = 'candidate_reads.fasta.gz'
    }

    withName: 'SEQKIT_RMDUP' {
        ext.args = '--by-seq --ignore-case'
        ext.prefix = 'unique_candidate_reads'
    }

    withName: 'SEQKIT_SPLIT_READ_QUERIES' {
        ext.args = { "--by-part ${params.blast_shards} --out-prefix read_queries" }
        ext.prefix = 'read_query_shards'
    }

    withName: 'BAITS_MAIN:WRITE_PROVENANCE' {
        publishDir = [
            path: { "${params.results}/${meta.id}/07_provenance" },
            mode: 'copy',
            pattern: '{inputs,parameters,software_versions}.tsv',
        ]
    }
}
