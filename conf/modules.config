process {
    withName: 'BAITS_MAIN:NORMALIZE_CURATED_SOURCE_SEQUENCES' {
        publishDir = [
            path: { "${outputDir}/${meta.id}/01_source_sequences" },
            mode: 'copy',
            pattern: 'source_sequences.fasta',
        ]
    }

    withName: 'BAITS_MAIN:DISCOVER_SOURCE_SEQUENCES:BLASTN_SOURCE_SEQUENCES' {
        publishDir = [
            path: { "${outputDir}/${meta.id}/01_source_sequences" },
            mode: 'copy',
            pattern: 'query_blast_hits.txt',
            saveAs: { 'query_blast_hits.tsv' },
        ]
    }

    withName: 'BAITS_MAIN:DISCOVER_SOURCE_SEQUENCES:EXTRACT_SOURCE_SEQUENCES' {
        publishDir = [
            path: { "${outputDir}/${meta.id}/01_source_sequences" },
            mode: 'copy',
            saveAs: { filename ->
                filename in ['source_sequences.fasta', 'candidate_loci.tsv', 'discovery_status.tsv']
                    ? filename
                    : null
            },
        ]
    }

    withName: 'BAITS_MAIN:FILTER_CANDIDATE_KMERS:BUILD_CANDIDATE_TABLES' {
        publishDir = [
            [
                path: { "${outputDir}/${meta.id}/02_candidate_kmers" },
                mode: 'copy',
                pattern: 'candidate_kmer_occurrences.tsv',
            ],
            [
                path: { "${outputDir}/${meta.id}/02_candidate_kmers" },
                mode: 'copy',
                pattern: 'filtering_status.tsv',
            ],
            [
                path: { "${outputDir}/${meta.id}/02_candidate_kmers" },
                mode: 'copy',
                pattern: 'terminal_candidate_kmers.tsv',
                saveAs: { 'candidate_kmers.tsv' },
            ],
        ]
    }

    withName: 'BAITS_MAIN:FILTER_CANDIDATE_KMERS:APPLY_COMPLEXITY_FILTER' {
        publishDir = [
            [
                path: { "${outputDir}/${meta.id}/02_candidate_kmers" },
                mode: 'copy',
                pattern: 'candidate_kmers.tsv',
                saveAs: { params.taxon_ref_db ? null : 'candidate_kmers.tsv' },
            ],
            [
                path: { "${outputDir}/${meta.id}/02_candidate_kmers" },
                mode: 'copy',
                pattern: 'terminal_candidate_kmers.tsv',
                saveAs: { params.taxon_ref_db ? 'candidate_kmers.tsv' : null },
            ],
            [
                path: { "${outputDir}/${meta.id}/02_candidate_kmers" },
                mode: 'copy',
                pattern: 'filtering_status.tsv',
            ],
            [
                path: { "${outputDir}/${meta.id}/04_bait_sets" },
                mode: 'copy',
                pattern: 'locally_filtered_baits.fasta',
            ],
        ]
    }

    withName: 'BAITS_MAIN:TAXONOMIC_EXACT_MATCH_SCREENING:BLASTN_TAXONOMIC_SCREENING' {
        publishDir = [
            [
                path: { "${outputDir}/${meta.id}/03_taxonomic_screening" },
                mode: 'copy',
                pattern: 'taxonomic_blast_hits.tsv',
                saveAs: { 'blast_hits.tsv' },
            ],
            [
                path: { "${outputDir}/${meta.id}/07_provenance" },
                mode: 'copy',
                pattern: 'taxonomic_reference_database.txt',
            ],
        ]
    }

    withName: 'BAITS_MAIN:TAXONOMIC_EXACT_MATCH_SCREENING:APPLY_TAXONOMIC_SCREENING' {
        publishDir = [
            [
                path: { "${outputDir}/${meta.id}/02_candidate_kmers" },
                mode: 'copy',
                pattern: 'candidate_kmers.tsv',
            ],
            [
                path: { "${outputDir}/${meta.id}/03_taxonomic_screening" },
                mode: 'copy',
                pattern: 'screening_decisions.tsv',
            ],
            [
                path: { "${outputDir}/${meta.id}/03_taxonomic_screening" },
                mode: 'copy',
                pattern: 'screening_status.tsv',
            ],
            [
                path: { "${outputDir}/${meta.id}/04_bait_sets" },
                mode: 'copy',
                pattern: 'taxonomically_screened_baits.fasta',
            ],
            [
                path: { "${outputDir}/${meta.id}/04_bait_sets" },
                mode: 'copy',
                pattern: 'terminal_bait_set_status.tsv',
                saveAs: { 'bait_set_status.tsv' },
            ],
        ]
    }

    withName: 'BAITS_MAIN:BUILD_VERIFY_DEACON_INDEX:VERIFY_DEACON_INDEX' {
        publishDir = [
            [
                path: { "${outputDir}/${meta.id}/04_bait_sets" },
                mode: 'copy',
                pattern: 'bait_set_status.tsv',
            ],
            [
                path: { "${outputDir}/${meta.id}/05_deacon_index" },
                mode: 'copy',
                pattern: 'verification_input/deacon.idx',
                saveAs: { "${index_source}.idx" },
            ],
            [
                path: { "${outputDir}/${meta.id}/05_deacon_index" },
                mode: 'copy',
                pattern: 'verification_summary.tsv',
            ],
            [
                path: { "${outputDir}/${meta.id}/05_deacon_index" },
                mode: 'copy',
                pattern: 'verification_report.md',
            ],
        ]
    }

    withName: 'BAITS_MAIN:CALIBRATE_THRESHOLD:PREPARE_READ_BLAST_QUERIES' {
        publishDir = [
            path: { "${outputDir}/${meta.id}/06_calibration" },
            mode: 'copy',
            saveAs: { filename ->
                filename in [
                    'candidate_read_counts.tsv',
                    'read_blast_hits.tsv',
                    'read_blast_search_parameters.tsv',
                    'classified_reads.tsv',
                    'threshold_read_counts.tsv',
                    'threshold_summary.tsv',
                ] ? filename : null
            },
        ]
    }

    withName: 'FIND_CONCATENATE' {
        ext.prefix = 'candidate_reads.fasta.gz'
    }

    withName: 'SEQKIT_RMDUP' {
        ext.args = '--by-seq --ignore-case'
        ext.prefix = 'unique_candidate_reads'
    }

    withName: 'SEQKIT_SPLIT_READ_QUERIES' {
        ext.args = { "--by-part ${params.blast_shards} --out-prefix read_queries" }
        ext.prefix = 'read_query_shards'
    }

    withName: 'BAITS_MAIN:CALIBRATE_THRESHOLD:GATHER_READ_BLAST_HITS' {
        publishDir = [
            path: { "${outputDir}/${meta.id}/06_calibration" },
            mode: 'copy',
            pattern: '{read_blast_hits,read_blast_search_parameters}.tsv',
        ]
    }

    withName: 'BAITS_MAIN:CALIBRATE_THRESHOLD:CLASSIFY_READ_HITS' {
        publishDir = [
            path: { "${outputDir}/${meta.id}/06_calibration" },
            mode: 'copy',
            pattern: 'classified_reads.tsv',
        ]
    }

    withName: 'BAITS_MAIN:CALIBRATE_THRESHOLD:CALIBRATE_THRESHOLD_EVIDENCE' {
        publishDir = [
            path: { "${outputDir}/${meta.id}/06_calibration" },
            mode: 'copy',
            pattern: 'threshold_*.tsv',
        ]
    }

    withName: 'BAITS_MAIN:WRITE_PROVENANCE' {
        publishDir = [
            path: { "${outputDir}/${meta.id}/07_provenance" },
            mode: 'copy',
            pattern: '{inputs,parameters,software_versions}.tsv',
        ]
    }
}
