params {
    id                      = null
    input                   = null
    source_sequences        = null
    target_taxid            = null
    interference_background = null
    optimization_read_set   = null
    kmer_size              = 31
    deacon_window          = 1
    entropy_threshold      = 0.6
    taxonomic_reference_db = null
    help            = false
    help_full       = false
    show_hidden     = false
    validate_params = true
    version         = false
}

process {
    cpus = 1
    memory = '2 GB'
    withName: 'BLAST_MAKEBLASTDB' {
        ext.args = '-dbtype nucl'
    }
}

manifest {
    name            = 'dholab/baits'
    homePage        = 'https://github.com/dholab/baits'
    description     = 'Build auditable bait sets of clean k-mers for biological targets'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.04.6'
    version         = '0.1.0.dev0'
}

plugins {
    id 'nf-schema@2.5.1'
}
