{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/dholab/baits/main/nextflow_schema.json",
    "title": "dholab/baits pipeline parameters",
    "description": "Build auditable bait sets for biological targets",
    "type": "object",
    "$defs": {
        "source_sequence_options": {
            "title": "Source sequence options",
            "type": "object",
            "description": "Supply a main samplesheet or one curated source sequence FASTA.",
            "properties": {
                "input": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "Path to the main samplesheet."
                },
                "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                    "description": "Optional identifier for one direct curated run. The source sequence FASTA name is used when this parameter is absent."
                },
                "source_sequences": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.(fa|fasta|fna)(\\.gz)?$",
                    "description": "Path to one curated source sequence FASTA."
                },
                "target_taxid": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$",
                    "description": "NCBI Taxonomy identifier for the target taxon."
                },
                "background": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.(fa|fasta|fna)(\\.gz)?$",
                    "description": "Path to the background FASTA used for exact-match cancellation."
                },
                "calibration_reads": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true,
                    "description": "Optional flat FASTQ directory used to calibrate a threshold."
                },
                "calibration_target_taxids": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_calibration_target_taxids.json",
                    "pattern": "^\\S+\\.tsv$",
                    "description": "Optional TSV of taxids treated as target-compatible only during calibration. Defaults to target_taxid."
                },
                "kmer_size": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 31,
                    "description": "Candidate k-mer length."
                },
                "deacon_window": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1,
                    "description": "Deacon minimizer window length."
                },
                "entropy_threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.6,
                    "description": "Deacon minimum scaled entropy threshold."
                }
            },
            "oneOf": [
                {
                    "required": ["input"],
                    "not": {
                        "anyOf": [
                            {"required": ["id"]},
                            {"required": ["source_sequences"]},
                            {"required": ["target_taxid"]},
                            {"required": ["background"]},
                            {"required": ["calibration_reads"]},
                            {"required": ["calibration_target_taxids"]}
                        ]
                    }
                },
                {
                    "required": ["source_sequences", "target_taxid", "background"],
                    "not": {"required": ["input"]}
                }
            ]
        },
        "taxonomic_screening_options": {
            "title": "Taxonomic exact-match screening options",
            "type": "object",
            "properties": {
                "taxon_ref_db": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true,
                    "description": "Optional taxonomic reference database directory."
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "properties": {
                "help": {
                    "type": ["boolean", "string"],
                    "description": "Display the help message."
                },
                "help_full": {
                    "type": "boolean",
                    "description": "Display the full help message."
                },
                "show_hidden": {
                    "type": "boolean",
                    "description": "Display hidden parameters in the help message."
                },
                "validate_params": {
                    "type": "boolean",
                    "default": true,
                    "description": "Validate parameters against the pipeline schema.",
                    "hidden": true
                },
                "version": {
                    "type": "boolean",
                    "description": "Display the pipeline version.",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        {"$ref": "#/$defs/source_sequence_options"},
        {"$ref": "#/$defs/taxonomic_screening_options"},
        {"$ref": "#/$defs/generic_options"},
        {
            "if": {"required": ["calibration_reads"]},
            "then": {"required": ["taxon_ref_db"]}
        },
        {
            "if": {"required": ["calibration_target_taxids"]},
            "then": {"required": ["calibration_reads"]}
        }
    ]
}
