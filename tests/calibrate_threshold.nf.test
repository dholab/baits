nextflow_pipeline {
    name "Calibrate threshold"
    script "../main.nf"
    tag "calibrate_threshold"

    test("publishes shared calibration tables and the run-level database description") {
        setup {
            def sequence = 'ACGTTGCATGTCAGTACGATCGTAG' * 4
            new File("$outputDir/source.fasta").text = ">target\n${sequence}\n"
            new File("$outputDir/calibration_reads").mkdirs()
            new File("$outputDir/calibration_reads/sample; one.fastq").text = "@repeated\n${sequence}\n+\n${'I' * sequence.size()}\n"
            def compressedRead = new java.util.zip.GZIPOutputStream(new FileOutputStream("$outputDir/calibration_reads/sample_R2.fastq.gz"))
            compressedRead.write("@repeated\n${sequence}\n+\n${'I' * sequence.size()}\n".bytes)
            compressedRead.close()
            new File("$outputDir/calibration_reads/.hidden.fastq").text = "@hidden\n${sequence}\n+\n${'I' * sequence.size()}\n"
            new File("$outputDir/calibration_reads/nested").mkdirs()
            new File("$outputDir/calibration_reads/nested/ignored.fastq").text = "@ignored\n${sequence}\n+\n${'I' * sequence.size()}\n"
            new File("$outputDir/calibration_reads/README.txt").text = "ignored\n"
            new File("$outputDir/taxonomic_reference_db").mkdirs()
            assert ["pixi", "run", "--environment", "dev", "makeblastdb", "-dbtype", "nucl", "-parse_seqids", "-taxid", "88456", "-in", "$outputDir/source.fasta", "-out", "$outputDir/taxonomic_reference_db/taxonomic"].execute().waitFor() == 0
        }
        when {
            params {
                id = "calibrated"
                source_sequences = "$outputDir/source.fasta"
                target_taxid = "88456"
                background = "$baseDir/tests/data/background.fasta"
                calibration_reads = "$outputDir/calibration_reads"
                taxon_ref_db = "$outputDir/taxonomic_reference_db"
                max_blast_targets = 7
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            assert new File("$runDir/results").list().sort() == [
                'artifacts',
                'calibration_matches.tsv.gz',
                'calibration_reads.tsv',
                'calibration_thresholds.tsv',
                'candidate_kmer_occurrences.tsv',
                'candidate_kmers.tsv',
                'candidate_loci.tsv',
                'source_matches.tsv.gz',
                'taxonomic_database.txt',
                'taxonomic_matches.tsv.gz',
            ]
            def design = new File("$runDir/results/calibrated")
            def artifacts = new File("$runDir/results/artifacts/calibrated")
            assert new File(artifacts, 'source_sequences.fasta').exists()
            assert new File(artifacts, 'baits.fasta').exists()
            assert new File(artifacts, 'deacon.idx').exists()
            assert artifacts.list().sort() == ['baits.fasta', 'deacon.idx', 'source_sequences.fasta']
            def taxonomicMatches = new java.util.zip.GZIPInputStream(new FileInputStream("$runDir/results/taxonomic_matches.tsv.gz")).text
            assert taxonomicMatches.readLines()[0].startsWith('design_id\tkmer\tsubject_accession')
            assert !new File(design, '03_taxonomic_screening').exists()
            assert !new File(design, '06_calibration').exists()
            def calibrationReads = new File("$runDir/results/calibration_reads.tsv")
            assert calibrationReads.readLines().size() == 4
            assert calibrationReads.readLines()[0] == 'design_id\tmetagenome_id\tread_id\tread_length\tbait_count\tquery_id\tbest_target_bit_score\tbest_other_bit_score'
            assert calibrationReads.text.contains('calibrated\tsample_R2\tread_000000000001\t')
            assert !calibrationReads.readLines()[0].contains('classification')
            def calibrationMatches = new java.util.zip.GZIPInputStream(new FileInputStream("$runDir/results/calibration_matches.tsv.gz")).text
            assert calibrationMatches.readLines().size() > 1
            assert calibrationMatches.readLines()[0].startsWith('design_id\tquery_id\tquery_length')
            assert new File("$runDir/results/calibration_thresholds.tsv").text == 'design_id\trecommended_threshold\ncalibrated\t1\n'
            assert !design.exists()
            assert new File("$runDir/results/taxonomic_database.txt").text
        }
    }

    test("publishes header-only calibration tables without candidate reads") {
        setup {
            def sequence = 'ACGTTGCATGTCAGTACGATCGTAG' * 4
            def unrelated = 'T' * sequence.size()
            new File("$outputDir/source.fasta").text = ">target\n${sequence}\n"
            new File("$outputDir/calibration_reads").mkdirs()
            new File("$outputDir/calibration_reads/sample.fastq").text = "@fragment\n${unrelated}\n+\n${'I' * unrelated.size()}\n"
            new File("$outputDir/taxonomic_reference_db").mkdirs()
            assert ["pixi", "run", "--environment", "dev", "makeblastdb", "-dbtype", "nucl", "-parse_seqids", "-taxid", "88456", "-in", "$outputDir/source.fasta", "-out", "$outputDir/taxonomic_reference_db/taxonomic"].execute().waitFor() == 0
        }
        when {
            params {
                id = "no_candidates"
                source_sequences = "$outputDir/source.fasta"
                target_taxid = "88456"
                background = "$baseDir/tests/data/background.fasta"
                calibration_reads = "$outputDir/calibration_reads"
                taxon_ref_db = "$outputDir/taxonomic_reference_db"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            assert !new File("$runDir/results/no_candidates/06_calibration").exists()
            assert new File("$runDir/results/calibration_reads.tsv").readLines().size() == 1
            def calibrationMatches = new java.util.zip.GZIPInputStream(new FileInputStream("$runDir/results/calibration_matches.tsv.gz")).text
            assert calibrationMatches.readLines().size() == 1
            assert new File("$runDir/results/calibration_thresholds.tsv").text == 'design_id\trecommended_threshold\nno_candidates\t\n'
            assert !new File("$runDir/results/no_candidates").exists()
        }
    }

    test("keeps calibration target scope isolated from bait screening") {
        setup {
            def source = 'ACGTTGCATGTCAGTACGATCGTAG' * 4
            def genusSegment = 'T' * 69
            def read = source + genusSegment
            new File("$outputDir/source.fasta").text = ">species_target\n${source}\n"
            new File("$outputDir/calibration_reads").mkdirs()
            new File("$outputDir/calibration_reads/sample.fastq").text = "@fragment\n${read}\n+\n${'I' * read.size()}\n"
            new File("$outputDir/genus_reference.fasta").text = ">genus_target\n${genusSegment}\n"
            new File("$outputDir/taxonomic_reference_db").mkdirs()
            new File("$outputDir/scope.tsv").text = 'taxid\n44417\n88456\n'
            new File("$outputDir/designs.csv").text = """\
id,target_taxid,curated_source_sequences,representative_queries,query_rules,target_assembly,background,calibration_reads,calibration_target_taxids
default_scope,88456,$outputDir/source.fasta,,,,$baseDir/tests/data/background.fasta,$outputDir/calibration_reads,
genus_scope,88456,$outputDir/source.fasta,,,,$baseDir/tests/data/background.fasta,$outputDir/calibration_reads,$outputDir/scope.tsv
"""
            assert ["pixi", "run", "--environment", "dev", "makeblastdb", "-dbtype", "nucl", "-parse_seqids", "-taxid", "44417", "-in", "$outputDir/genus_reference.fasta", "-out", "$outputDir/taxonomic_reference_db/taxonomic"].execute().waitFor() == 0
        }
        when {
            params {
                input = "$outputDir/designs.csv"
                taxon_ref_db = "$outputDir/taxonomic_reference_db"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            def defaultDesign = new File("$runDir/results/default_scope")
            def genusDesign = new File("$runDir/results/genus_scope")
            def defaultArtifacts = new File("$runDir/results/artifacts/default_scope")
            def genusArtifacts = new File("$runDir/results/artifacts/genus_scope")
            assert new File(defaultArtifacts, 'baits.fasta').bytes == new File(genusArtifacts, 'baits.fasta').bytes
            assert ['source_sequences.fasta', 'baits.fasta', 'deacon.idx'].every { new File(defaultArtifacts, it).exists() }
            assert ['source_sequences.fasta', 'baits.fasta', 'deacon.idx'].every { new File(genusArtifacts, it).exists() }
            def calibrationRows = new File("$runDir/results/calibration_reads.tsv").readLines().drop(1).collect { it.split('\t', -1) }
            def defaultRow = calibrationRows.find { it[0] == 'default_scope' }
            def genusRow = calibrationRows.find { it[0] == 'genus_scope' }
            assert defaultRow[6] == '' && defaultRow[7]
            assert genusRow[6] && genusRow[7] == ''
            assert !defaultDesign.exists()
            assert !genusDesign.exists()
        }
    }

    test("does not calibrate when taxonomic exact-match screening yields no baits") {
        setup {
            def sequence = 'ACGTTGCATGTCAGTACGATCGTAG' * 4
            new File("$outputDir/source.fasta").text = ">target\n${sequence}\n"
            new File("$outputDir/calibration_reads").mkdirs()
            new File("$outputDir/calibration_reads/sample.fastq").text = "@fragment\n${sequence}\n+\n${'I' * sequence.size()}\n"
            new File("$outputDir/taxonomic_reference_db").mkdirs()
            assert ["pixi", "run", "--environment", "dev", "makeblastdb", "-dbtype", "nucl", "-parse_seqids", "-taxid", "123", "-in", "$outputDir/source.fasta", "-out", "$outputDir/taxonomic_reference_db/taxonomic"].execute().waitFor() == 0
        }
        when {
            params {
                id = "screening_terminal"
                source_sequences = "$outputDir/source.fasta"
                target_taxid = "88456"
                background = "$baseDir/tests/data/background.fasta"
                calibration_reads = "$outputDir/calibration_reads"
                taxon_ref_db = "$outputDir/taxonomic_reference_db"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            def design = new File("$runDir/results/screening_terminal")
            def candidateRows = new File("$runDir/results/candidate_kmers.tsv").readLines().drop(1)*.split('\t')
            def offTargetKmers = candidateRows.findAll { it[3] == 'off_target_match' }.collect { it[1] }.toSet()
            assert offTargetKmers
            def taxonomicMatches = new java.util.zip.GZIPInputStream(new FileInputStream("$runDir/results/taxonomic_matches.tsv.gz")).text
            assert taxonomicMatches.readLines().drop(1).every { it.startsWith('screening_terminal\t') }
            assert taxonomicMatches.readLines().size() > 1
            def matchedKmers = taxonomicMatches.readLines().drop(1)*.split('\t')*.getAt(1).toSet()
            assert matchedKmers.containsAll(offTargetKmers)
            assert !new File(design, '06_calibration').exists()
            assert new File("$runDir/results/calibration_reads.tsv").readLines().size() == 1
            def calibrationMatches = new java.util.zip.GZIPInputStream(new FileInputStream("$runDir/results/calibration_matches.tsv.gz")).text
            assert calibrationMatches.readLines().size() == 1
            assert new File("$runDir/results/artifacts/screening_terminal/baits.fasta").text == ''
            assert !new File("$runDir/results/artifacts/screening_terminal/deacon.idx").exists()
            assert !design.exists()
            assert new File("$runDir/results/calibration_thresholds.tsv").text == 'design_id\trecommended_threshold\nscreening_terminal\t\n'
        }
    }
}
