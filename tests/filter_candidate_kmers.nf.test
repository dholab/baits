nextflow_pipeline {
    name "Filter candidate k-mers"
    script "../main.nf"
    tag "filter_candidate_kmers"
    test("publishes only canonical evidence and nonempty locally filtered baits") {
        when {
            params {
                id = "positive"
                source_sequences = "$baseDir/tests/data/filter_source_sequences.fasta"
                target_taxid = "88456"
                background = "$baseDir/tests/data/interference_background.fasta"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            def candidate = new File("$runDir/results/positive/02_candidate_kmers")
            assert new File(candidate, 'candidate_kmers.tsv').text.contains('REJECT_LOW_COMPLEXITY')
            assert new File(candidate, 'candidate_kmer_occurrences.tsv').exists()
            assert new File(candidate, 'filtering_status.tsv').exists()
            assert new File("$runDir/results/positive/04_bait_sets/locally_filtered_baits.fasta").exists()
            assert new File("$runDir/results/positive/04_bait_sets/bait_set_status.tsv").text.contains('deacon_index_source\tlocally_filtered')
            assert new File("$runDir/results/positive/05_deacon_index/locally_filtered.idx").exists()
            assert new File("$runDir/results/positive/05_deacon_index/verification_summary.tsv").text.contains('bait_sequence_sets_equal\ttrue')
            assert new File("$runDir/results/positive/05_deacon_index/verification_report.md").exists()
            assert !new File("$runDir/results/positive/02_candidate_kmers/source_sequence_metadata.tsv").exists()
            assert new File("$runDir/results/positive/07_provenance/parameters.tsv").text.contains('kmer_size\t31')
            assert new File("$runDir/results/positive/07_provenance/software_versions.tsv").text.contains('deacon\t0.15.0')
            assert new File("$runDir/results/positive/07_provenance/software_versions.tsv").text.contains('polars\t1.43.2')
        }
    }
    test("all-background cancellation publishes evidence without a continuation") {
        when {
            params {
                id = "background_terminal"
                source_sequences = "$baseDir/tests/data/filter_source_sequences.fasta"
                target_taxid = "88456"
                background = "$baseDir/tests/data/filter_source_sequences.fasta"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            assert new File("$runDir/results/background_terminal/02_candidate_kmers/filtering_status.tsv").text.endsWith('explicit_background_cancellation\n')
            assert !new File("$runDir/results/background_terminal/04_bait_sets/locally_filtered_baits.fasta").exists()
            def provenance = new File("$runDir/results/background_terminal/07_provenance")
            assert provenance.list().sort() == ['inputs.tsv', 'parameters.tsv', 'software_versions.tsv']
            assert new File(provenance, 'parameters.tsv').readLines() == [
                'parameter\tvalue',
                'deacon_window\t1',
                'entropy_threshold\t0.6',
                'kmer_size\t31',
                'target_taxid\t88456',
            ]
            assert new File(provenance, 'software_versions.tsv').readLines().collect { it.split('\t')[0] } == [
                'component', 'biopython', 'meryl', 'polars', 'python',
            ]
        }
    }
    test("reports Meryl background positional multiplicity") {
        when {
            params {
                id = "background_multiplicity"
                source_sequences = "$baseDir/tests/data/filter_source_sequences.fasta"
                target_taxid = "88456"
                background = "$baseDir/tests/data/filter_three_background.fasta"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            assert new File("$runDir/results/background_multiplicity/02_candidate_kmers/candidate_kmers.tsv").text.contains('ACGTACGTACGTACGTACGTACGTACGTACG\t1\t3\tREJECT_INTERFERENCE_BACKGROUND')
        }
    }
    test("stages same-basename source and background files without database collision") {
        setup {
            new File("$outputDir/source").mkdirs()
            new File("$outputDir/background").mkdirs()
            new File("$outputDir/source/shared.fasta").text = new File("$baseDir/tests/data/filter_source_sequences.fasta").text
            new File("$outputDir/background/shared.fasta").text = new File("$baseDir/tests/data/interference_background.fasta").text
        }
        when {
            params {
                id = "same_basename"
                source_sequences = "$outputDir/source/shared.fasta"
                target_taxid = "88456"
                background = "$outputDir/background/shared.fasta"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            assert new File("$runDir/results/same_basename/02_candidate_kmers/candidate_kmers.tsv").exists()
            assert new File("$runDir/results/same_basename/04_bait_sets/locally_filtered_baits.fasta").exists()
        }
    }
    test("short source sequences publish candidate enumeration evidence without baits") {
        when {
            params {
                id = "short_terminal"
                source_sequences = "$baseDir/tests/data/filter_short_source.fasta"
                target_taxid = "88456"
                background = "$baseDir/tests/data/interference_background.fasta"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            def stage = new File("$runDir/results/short_terminal/02_candidate_kmers")
            assert new File(stage, 'candidate_kmers.tsv').exists()
            assert new File(stage, 'candidate_kmer_occurrences.tsv').exists()
            assert new File(stage, 'filtering_status.tsv').text.endsWith('candidate_kmer_enumeration\n')
            assert !new File("$runDir/results/short_terminal/04_bait_sets/locally_filtered_baits.fasta").exists()
            def provenance = new File("$runDir/results/short_terminal/07_provenance")
            assert provenance.list().sort() == ['inputs.tsv', 'parameters.tsv', 'software_versions.tsv']
            assert new File(provenance, 'parameters.tsv').readLines() == [
                'parameter\tvalue',
                'deacon_window\t1',
                'entropy_threshold\t0.6',
                'kmer_size\t31',
                'target_taxid\t88456',
            ]
            assert new File(provenance, 'software_versions.tsv').readLines().collect { it.split('\t')[0] } == [
                'component', 'biopython', 'meryl', 'polars', 'python',
            ]
        }
    }
    test("all low-complexity candidates publish evidence without baits") {
        when {
            params {
                id = "complexity_terminal"
                source_sequences = "$baseDir/tests/data/filter_low_complexity_source.fasta"
                target_taxid = "88456"
                background = "$baseDir/tests/data/interference_background.fasta"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            def stage = new File("$runDir/results/complexity_terminal/02_candidate_kmers")
            assert new File(stage, 'candidate_kmers.tsv').text.contains('REJECT_LOW_COMPLEXITY')
            assert new File(stage, 'filtering_status.tsv').text.endsWith('low_complexity_filtering\n')
            assert !new File("$runDir/results/complexity_terminal/04_bait_sets/locally_filtered_baits.fasta").exists()
        }
    }
    test("pairs independent designs with their own source sequences") {
        setup {
            new File("$outputDir/multi.csv").text = """id,target_taxid,curated_source_sequences,representative_queries,query_rules,target_assembly,background
design_a,88456,$baseDir/tests/data/filter_source_sequences.fasta,,,,$baseDir/tests/data/interference_background.fasta
design_b,88456,$baseDir/tests/data/filter_low_complexity_source.fasta,,,,$baseDir/tests/data/interference_background.fasta
"""
        }
        when {
            params { input = "$outputDir/multi.csv" }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            assert new File("$runDir/results/design_a/04_bait_sets/locally_filtered_baits.fasta").exists()
            assert new File("$runDir/results/design_b/02_candidate_kmers/filtering_status.tsv").text.endsWith('low_complexity_filtering\n')
            assert !new File("$runDir/results/design_b/04_bait_sets/locally_filtered_baits.fasta").exists()
        }
    }
    test("screens nonterminal designs and retains terminal filtering evidence with a shared database") {
        setup {
            new File("$outputDir/taxonomic_reference_db").mkdirs()
            new File("$outputDir/taxonomic_reference.fasta").text = new File("$baseDir/tests/data/filter_source_sequences.fasta").text
            assert ["pixi", "run", "--environment", "dev", "makeblastdb", "-dbtype", "nucl", "-parse_seqids", "-taxid", "88456", "-in", "$outputDir/taxonomic_reference.fasta", "-out", "$outputDir/taxonomic_reference_db/taxonomic"].execute().waitFor() == 0
            new File("$outputDir/taxonomic_multi.csv").text = """id,target_taxid,curated_source_sequences,representative_queries,query_rules,target_assembly,background
design_a,88456,$baseDir/tests/data/filter_source_sequences.fasta,,,,$baseDir/tests/data/interference_background.fasta
design_b,88456,$baseDir/tests/data/filter_low_complexity_source.fasta,,,,$baseDir/tests/data/interference_background.fasta
"""
        }
        when {
            params {
                input = "$outputDir/taxonomic_multi.csv"
                taxon_ref_db = "$outputDir/taxonomic_reference_db"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            def screened = new File("$runDir/results/design_a")
            def terminal = new File("$runDir/results/design_b")
            assert new File(screened, '03_taxonomic_screening/blast_hits.tsv').exists()
            assert new File(screened, '03_taxonomic_screening/screening_decisions.tsv').exists()
            assert new File(screened, '03_taxonomic_screening/screening_status.tsv').exists()
            assert new File(screened, '04_bait_sets/taxonomically_screened_baits.fasta').exists()
            assert new File(screened, '04_bait_sets/bait_set_status.tsv').text.contains('deacon_index_source\ttaxonomically_screened')
            assert new File(screened, '05_deacon_index/taxonomically_screened.idx').exists()
            assert new File(screened, '07_provenance/taxonomic_reference_database.txt').text.contains('BLASTDB Version:')
            assert new File(screened, '07_provenance/inputs.tsv').text.contains('taxonomic_reference_database\ttaxonomic_reference_database\tdirectory\ttaxonomic_reference_db')
            assert new File(screened, '07_provenance/software_versions.tsv').text.contains('blast\t2.16.0')
            def screenedManifest = new File(screened, '02_candidate_kmers/candidate_kmers.tsv')
            assert screenedManifest.text.contains('\tPASS\tnone\tPASS\t')
            assert !screenedManifest.text.contains('\tNOT_RUN\t')
            assert new File(terminal, '02_candidate_kmers/candidate_kmers.tsv').exists()
            assert new File(terminal, '07_provenance/inputs.tsv').text.contains('taxonomic_reference_database\ttaxonomic_reference_database\tdirectory\ttaxonomic_reference_db')
            assert !new File(terminal, '07_provenance/software_versions.tsv').text.contains('blast\t')
            assert !new File(terminal, '03_taxonomic_screening/blast_hits.tsv').exists()
            assert !new File(terminal, '07_provenance/taxonomic_reference_database.txt').exists()
        }
    }

    test("publishes final bait set status without an index when screening rejects every bait") {
        setup {
            new File("$outputDir/rejecting_reference_db").mkdirs()
            new File("$outputDir/rejecting_reference.fasta").text = new File("$baseDir/tests/data/filter_source_sequences.fasta").text
            assert ["pixi", "run", "--environment", "dev", "makeblastdb", "-dbtype", "nucl", "-parse_seqids", "-taxid", "123", "-in", "$outputDir/rejecting_reference.fasta", "-out", "$outputDir/rejecting_reference_db/taxonomic"].execute().waitFor() == 0
        }
        when {
            params {
                id = "screening_terminal"
                source_sequences = "$baseDir/tests/data/filter_source_sequences.fasta"
                target_taxid = "88456"
                background = "$baseDir/tests/data/interference_background.fasta"
                taxon_ref_db = "$outputDir/rejecting_reference_db"
            }
        }
        then {
            assert workflow.success
            def runDir = new File(outputDir).parent
            def design = new File("$runDir/results/screening_terminal")
            assert new File(design, '03_taxonomic_screening/screening_status.tsv').text.contains('taxonomic_screening_status\tNO_BAITS')
            assert new File(design, '04_bait_sets/bait_set_status.tsv').text.endsWith('deacon_index_source\t\n')
            assert !new File(design, '04_bait_sets/taxonomically_screened_baits.fasta').exists()
            assert !new File(design, '05_deacon_index').exists()
        }
    }
}
