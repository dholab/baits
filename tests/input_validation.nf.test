nextflow_pipeline {
    name "Validate source sequence parameters"
    script "../main.nf"
    tag "input"

    test("rejects direct curated source sequences without a target taxon") {
        when {
            params {
                source_sequences = "$baseDir/tests/data/curated_source_sequences.fasta"
                background = "$baseDir/tests/data/interference_background.fasta"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("accepts one direct curated source sequence run") {
        when {
            params {
                id = "cyclospora"
                source_sequences = "$baseDir/tests/data/curated_source_sequences.fasta"
                target_taxid = "88456"
                background = "$baseDir/tests/data/interference_background.fasta"
            }
        }

        then {
            assert workflow.success
        }
    }

    test("accepts curated and query-guided samplesheet rows") {
        setup {
            new File("$outputDir/valid_input.csv").text = """\
id,target_taxid,curated_source_sequences,representative_queries,query_rules,target_assembly,background
curated,88456,$baseDir/tests/data/curated_source_sequences.fasta,,,,$baseDir/tests/data/interference_background.fasta
discovery,88456,,$baseDir/tests/data/representative_queries.fasta,$baseDir/tests/data/query_rules.tsv,$baseDir/tests/data/target_assembly.fasta,$baseDir/tests/data/interference_background.fasta
"""
        }

        when {
            params {
                input = "$outputDir/valid_input.csv"
            }
        }

        then {
            assert workflow.success
        }
    }

    test("rejects a row that mixes curated and query-guided inputs") {
        setup {
            new File("$outputDir/mixed_input.csv").text = """\
id,target_taxid,curated_source_sequences,representative_queries,query_rules,target_assembly,background
mixed,88456,$baseDir/tests/data/curated_source_sequences.fasta,$baseDir/tests/data/representative_queries.fasta,$baseDir/tests/data/query_rules.tsv,$baseDir/tests/data/target_assembly.fasta,$baseDir/tests/data/interference_background.fasta
"""
        }

        when {
            params {
                input = "$outputDir/mixed_input.csv"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("rejects query rules without a query group") {
        setup {
            new File("$outputDir/invalid_rules_input.csv").text = """\
id,target_taxid,curated_source_sequences,representative_queries,query_rules,target_assembly,background
discovery,88456,,$baseDir/tests/data/representative_queries.fasta,$baseDir/tests/data/invalid_query_rules.tsv,$baseDir/tests/data/target_assembly.fasta,$baseDir/tests/data/interference_background.fasta
"""
        }

        when {
            params {
                input = "$outputDir/invalid_rules_input.csv"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("rejects calibration reads without a taxonomic reference database") {
        setup {
            new File("$outputDir/calibration_reads").mkdirs()
            new File("$outputDir/calibration_reads/sample.fastq").text = '@fragment\nACGTA\n+\nIIIII\n'
            new File("$outputDir/calibration.csv").text = """id,target_taxid,curated_source_sequences,representative_queries,query_rules,target_assembly,background,calibration_reads
optimized,88456,$baseDir/tests/data/curated_source_sequences.fasta,,,,$baseDir/tests/data/interference_background.fasta,$outputDir/calibration_reads
"""
        }
        when {
            params {
                input = "$outputDir/calibration.csv"
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.join('\n').contains('calibration_reads requires taxon_ref_db')
        }
    }
}
