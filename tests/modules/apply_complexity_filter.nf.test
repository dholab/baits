nextflow_process {
    name "Apply complexity filter process"
    script "../../modules/local/apply_complexity_filter/main.nf"
    process "APPLY_COMPLEXITY_FILTER"

    test("marks low-complexity candidates and emits selected sequences") {
        when {
            process {
                """input[0] = [[id: 'design'], file(\"\$baseDir/tests/data/filter_manifest.tsv\"), file(\"\$baseDir/tests/data/filter_passing_kmers.fasta\")]"""
            }
        }
        then {
            assert process.success
            assert file(process.out.manifest[0][1]).text.contains('low_complexity')
            assert process.out.candidates.size() == 1
            assert file(process.out.candidates[0][1]).text.contains('ACGTTGCATGTCAGTACGATCGTAGCTAGCA')
        }
    }

    test("emits outcomes without selected candidates when nothing passes") {
        setup {
            new File("$outputDir/empty.fasta").text = ''
        }
        when {
            process {
                """input[0] = [[id: 'design'], file(\"\$baseDir/tests/data/filter_manifest.tsv\"), file(\"$outputDir/empty.fasta\")]"""
            }
        }
        then {
            assert process.success
            assert process.out.candidates.size() == 0
            assert file(process.out.manifest[0][1]).text.count('low_complexity') == 3
        }
    }
}
