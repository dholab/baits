nextflow_process {
    name "BLASTN source sequences process"
    script "../../modules/local/blastn_source_sequences/main.nf"
    process "BLASTN_SOURCE_SEQUENCES"

    test("stages the paired database input and declares hits and BLAST version") {
        when {
            options '-stub-run'
            process {
                """
                input[0] = [[id: 'design', source_sequence_origin: 'query_guided_discovery'], file(\"\$baseDir/tests/data/representative_queries.fasta\"), file(\"\$baseDir/tests/data\")]
                """
            }
        }


        then {
            assert process.success
            assert process.out.txt.size() == 1
            assert file(process.out.txt[0][1]).exists()
            assert process.out.versions_blast[0][0] == 'BLASTN_SOURCE_SEQUENCES'
            assert process.out.reported_blast[0][0].id == 'design'
            assert process.out.reported_blast[0][1] == 'blast'
        }
    }

    test("uses every allocated CPU for source discovery") {
        setup {
            def sequence = 'ACGTTGCATGTCAGTACGATCGTAG' * 4
            new File("$outputDir/query.fasta").text = ">query\n${sequence}\n"
            new File("$outputDir/reference.fasta").text = ">reference\n${sequence}\n"
            new File("$outputDir/database").mkdirs()
            assert ["pixi", "run", "--environment", "dev", "makeblastdb", "-dbtype", "nucl", "-in", "$outputDir/reference.fasta", "-out", "$outputDir/database/reference"].execute().waitFor() == 0
        }
        when {
            process {
                """input[0] = [[id: 'design'], file("$outputDir/query.fasta"), file("$outputDir/database")]"""
            }
        }
        then {
            assert process.success
            def command = new File(file(process.out.txt[0][1]).parent, '.command.sh').text
            assert command.contains('-num_threads 2')
        }
    }
}
