nextflow_process {
    name "Build candidate k-mer tables process"
    script "../../modules/local/build_candidate_tables/main.nf"
    process "BUILD_CANDIDATE_TABLES"
    test("builds canonical candidates with background outcomes") {
        when {
            process {
                """input[0] = [[id: 'design'], file(\"\$baseDir/tests/data/filter_source_sequences.fasta\"), file(\"\$baseDir/tests/data/filter_source_query_groups.tsv\"), file(\"\$baseDir/tests/data/filter_source_counts.tsv\"), file(\"\$baseDir/tests/data/filter_background_counts.tsv\"), 31]"""
            }
        }
        then {
            assert process.success
            assert file(process.out.tables[0][1]).readLines()[0].startsWith('candidate_kmer_id')
            assert file(process.out.tables[0][2]).readLines().size() == 5
            assert file(process.out.tables[0][1]).text.contains('ACGTACGTACGTACGTACGTACGTACGTACG\t1\t3\tbackground_match')
            assert process.out.complexity_candidates.size() == 1
        }
    }

    test("emits an empty complexity FASTA when every candidate matches the background") {
        when {
            process {
                """input[0] = [[id: 'design'], file(\"\$baseDir/tests/data/filter_source_sequences.fasta\"), file(\"\$baseDir/tests/data/filter_source_query_groups.tsv\"), file(\"\$baseDir/tests/data/filter_source_counts.tsv\"), file(\"\$baseDir/tests/data/filter_source_counts.tsv\"), 31]"""
            }
        }
        then {
            assert process.success
            assert process.out.complexity_candidates.size() == 1
            assert file(process.out.complexity_candidates[0][1]).text == ''
            assert file(process.out.tables[0][1]).text.count('background_match') == 4
        }
    }
}
