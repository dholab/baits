nextflow_process {
    name "Calibrate Deacon threshold process"
    script "../../modules/local/calibrate_deacon_threshold_evidence/main.nf"
    process "CALIBRATE_DEACON_THRESHOLD_EVIDENCE"

    test("writes a Recommended Deacon Absolute Threshold") {
        setup {
            new File("$outputDir/classified.tsv").text = 'metagenome_id\tfragment_id\tmate\tread_length\tdistinct_bait_count\tfragment_distinct_bait_count\trepresentative_id\tclassification\tbest_target_bit_score\tbest_non_target_bit_score\nsample\tfragment\t1\t5\t1\t1\trepresentative_000001\tTARGET\t10\t\n'
            new File("$outputDir/preparation.tsv").text = 'metric\tvalue\ndesign_id\tdesign\ndeacon_returned_read_count\t1\nduplicate_fragment_count\t0\nzero_bait_read_count\t0\ncandidate_read_count\t1\nwhole_read_blast_query_count\t1\n'
        }
        when {
            process {
                """input[0] = [[id: 'design'], file("$outputDir/classified.tsv"), file("$outputDir/preparation.tsv")]"""
            }
        }
        then {
            assert process.success
            assert file(process.out.summary[0][1]).text.contains('recommended_deacon_absolute_threshold\t1')
            assert process.out.read_counts.size() == 1
            assert process.out.curve.size() == 1
        }
    }
}
