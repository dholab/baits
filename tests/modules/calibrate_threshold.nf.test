nextflow_process {
    name "Derive recommended threshold process"
    script "../../modules/local/calibrate_threshold/main.nf"
    process "DERIVE_RECOMMENDED_THRESHOLD"

    test("writes only the recommended threshold") {
        setup {
            new File("$outputDir/calibration_reads.tsv").text = 'metagenome_id\tread_id\tread_length\tbait_count\tquery_id\tbest_target_bit_score\tbest_other_bit_score\nsample\tread_000000000001\t5\t1\tquery\t10\t\n'
        }
        when {
            process {
                """input[0] = [[id: 'design'], file("$outputDir/calibration_reads.tsv")]"""
            }
        }
        then {
            assert process.success
            assert file(process.out.threshold[0][1]).text == 'design_id\trecommended_threshold\ndesign\t1\n'
        }
    }
}
