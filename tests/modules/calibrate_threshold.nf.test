nextflow_process {
    name "Calibrate threshold process"
    script "../../modules/local/calibrate_threshold/main.nf"
    process "CALIBRATE_THRESHOLD_EVIDENCE"

    test("writes a recommended threshold") {
        setup {
            new File("$outputDir/classified.tsv").text = 'metagenome_id\tread_id\tread_length\tbait_count\trepresentative_id\tclassification\tbest_target_bit_score\tbest_non_target_bit_score\nsample\tread_000000000001\t5\t1\trepresentative_000001\tTARGET\t10\t\n'
            new File("$outputDir/preparation.tsv").text = 'metric\tvalue\ndesign_id\tdesign\ndeacon_returned_read_count\t1\ncandidate_read_count\t1\nduplicate_sequence_count\t0\nread_blast_query_count\t1\n'
        }
        when {
            process {
                """input[0] = [[id: 'design'], file("$outputDir/classified.tsv"), file("$outputDir/preparation.tsv")]"""
            }
        }
        then {
            assert process.success
            assert file(process.out.summary[0][1]).text.contains('recommended_threshold\t1')
            assert process.out.read_counts.size() == 1
        }
    }
}
