nextflow_process {
    name "Count candidate read baits process"
    script "../../modules/local/count_read_baits/main.nf"
    process "COUNT_READ_BAITS"

    test("streams independent candidate reads without using their headers") {
        setup {
            new File("$outputDir/baits.fasta").text = '>bait\nACGTA\n'
            new File("$outputDir/reads.fasta").text = '>repeated\nACGTA\n>repeated\nTACGT\n'
        }
        when {
            process {
                """input[0] = [[id: 'design'], [id: 'design__sample', design_id: 'design', metagenome_id: 'sample'], file("$outputDir/baits.fasta"), [file("$outputDir/reads.fasta")], 5]"""
            }
        }
        then {
            assert process.success
            assert process.out.counts.size() == 1
            assert file(process.out.counts[0][2]).readLines().size() == 3
            assert file(process.out.counts[0][2]).text.contains('sample\tread_000000000001\t5\t1\tsequence_')
            assert file(process.out.counts[0][2]).text.contains('sample\tread_000000000002\t5\t1\tsequence_')
            assert file(process.out.status[0][2]).text.contains('candidate_read_count\t2')
        }
    }
}
