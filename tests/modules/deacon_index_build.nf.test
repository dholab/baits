nextflow_process {
    name "Deacon index build process"
    script "../../modules/local/deacon_index_build/main.nf"
    process "DEACON_INDEX_BUILD"
    test("receives explicit scientific arguments in its queue tuple") {
        when {
            options '-stub-run'
            process { """input[0] = [[id: 'design'], file(\"\$baseDir/tests/data/filter_passing_kmers.fasta\"), 31, 1, 0.6]""" }
        }
        then {
            assert process.success
            assert process.out.index.size() == 1
            assert process.out.reported_deacon[0][1] == 'deacon'
        }
    }
}
