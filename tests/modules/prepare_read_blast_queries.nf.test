nextflow_process {
    name "Prepare read BLAST queries process"
    script "../../modules/local/prepare_read_blast_queries/main.nf"
    process "PREPARE_READ_BLAST_QUERIES"

    test("preserves read rows while consuming globally unique queries") {
        setup {
            def representative = 'sequence_8be635b3b461bfc5d03b08aa3ee554d044abedfa1ee7dc70ee5fbf7f665ae219'
            new File("$outputDir/design__sample.counted_reads.tsv").text = "metagenome_id\tread_id\tread_length\tbait_count\trepresentative_id\nsample\tread_000000000001\t5\t1\t${representative}\nsample\tread_000000000002\t5\t1\t${representative}\n"
            new File("$outputDir/unique.fasta").text = ">${representative}\nACGTA\n"
            new File("$outputDir/design__sample.candidate_read_status.tsv").text = 'metric\tvalue\nmetagenome_id\tsample\ndeacon_returned_read_count\t2\ncandidate_read_count\t2\n'
        }
        when {
            process {
                """input[0] = [[id: 'design'], [file("$outputDir/design__sample.counted_reads.tsv")], [file("$outputDir/design__sample.candidate_read_status.tsv")], file("$outputDir/unique.fasta")]"""
            }
        }
        then {
            assert process.success
            assert process.out.candidate_read_counts.size() == 1
            assert process.out.queries.size() == 1
            assert process.out.terminal_summary.size() == 0
            assert file(process.out.candidate_read_counts[0][1]).readLines().size() == 3
            assert file(process.out.preparation_summary[0][1]).text.contains('duplicate_sequence_count\t1')
        }
    }
}
