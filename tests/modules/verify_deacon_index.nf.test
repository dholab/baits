nextflow_process {
    name "Verify Deacon index process"
    script "../../modules/local/verify_deacon_index/main.nf"
    process "VERIFY_DEACON_INDEX"

    test("verifies candidate, bait, and Deacon round-trip relations") {
        setup {
            new File("$outputDir/background_roundtrip.fasta").text = ""
            new File("$outputDir/deacon.idx").text = "verified index"
        }
        when {
            process {
                """input[0] = [[id: 'design'], file("\$baseDir/tests/data/taxonomic_input_baits.fasta"), file("\$baseDir/tests/data/taxonomic_input_baits.fasta"), file("$outputDir/background_roundtrip.fasta"), file("\$baseDir/tests/data/taxonomic_candidate_kmers.tsv"), file("$outputDir/deacon.idx"), 31]"""
            }
        }

        then {
            assert process.success
            assert process.out.index.size() == 1
            assert file(process.out.index[0][1]).text == 'verified index'
            assert process.out.versions_biopython[0][1] == 'biopython'
            assert process.out.versions_python[0][1] == 'python'
        }
    }
}
