nextflow_workflow {
    name "Build and verify Deacon index subworkflow"
    script "../subworkflows/local/build_verify_deacon_index/main.nf"
    workflow "BUILD_VERIFY_DEACON_INDEX"

    test("builds and verifies a Deacon index from a locally filtered bait set") {
        setup {
            def compressed = new java.util.zip.GZIPOutputStream(
                new java.io.FileOutputStream(new File("$outputDir/interference_background.fasta.gz"))
            )
            compressed.write(new File("$baseDir/tests/data/interference_background.fasta").bytes)
            compressed.close()
        }
        when {
            workflow {
                """
                input[0] = Channel.of([[id: 'design', source_sequence_origin: 'curated_input'], file("\$baseDir/tests/data/taxonomic_locally_filtered_baits.fasta"), file("\$baseDir/tests/data/taxonomic_candidate_kmers.tsv"), file("\$baseDir/tests/data/taxonomic_bait_set_status.tsv"), file("$outputDir/interference_background.fasta.gz")])
                input[1] = Channel.value(31)
                input[2] = Channel.value(1)
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.index.size() == 1
            assert workflow.out.bait_set_status.size() == 1
            assert workflow.out.summary.size() == 1
            assert workflow.out.report.size() == 1
            assert file(workflow.out.index[0][4]).exists()
            assert file(workflow.out.bait_set_status[0][1]).readLines().last() == 'deacon_index_source\tlocally_filtered'
            assert file(workflow.out.summary[0][1]).readLines().find {
                it == 'interference_background_roundtrip_record_count\t0'
            }
        }
    }
}
