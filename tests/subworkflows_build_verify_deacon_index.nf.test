nextflow_workflow {
    name "Build and verify Deacon index subworkflow"
    script "../subworkflows/local/build_verify_deacon_index/main.nf"
    workflow "BUILD_VERIFY_DEACON_INDEX"

    test("builds and verifies a Deacon index from selected candidates") {
        setup {
            def compressed = new java.util.zip.GZIPOutputStream(
                new java.io.FileOutputStream(new File("$outputDir/background.fasta.gz"))
            )
            compressed.write(new File("$baseDir/tests/data/background.fasta").bytes)
            compressed.close()
        }
        when {
            workflow {
                """
                input[0] = Channel.of([[id: 'design'], file("\$baseDir/tests/data/taxonomic_input_baits.fasta"), file("\$baseDir/tests/data/taxonomic_candidate_kmers.tsv"), file("$outputDir/background.fasta.gz")])
                input[1] = Channel.value(31)
                input[2] = Channel.value(1)
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.index.size() == 1
            assert file(workflow.out.index[0][3]).exists()
        }
    }
}
