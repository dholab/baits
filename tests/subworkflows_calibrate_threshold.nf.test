nextflow_workflow {
    name "Calibrate threshold subworkflow"
    script "../subworkflows/local/calibrate_threshold/main.nf"
    workflow "CALIBRATE_THRESHOLD"

    test("runs BLAST across two query files and combines the results") {
        setup {
            def firstSequence = 'ACGTA' + ('G' * 95)
            def secondSequence = 'ACGTA' + ('C' * 95)
            new File("$outputDir/baits.fasta").text = '>candidate_kmer_000001\nACGTA\n'
            new File("$outputDir/reads.fastq").text = "@first\n${firstSequence}\n+\n${'I' * 100}\n@second\n${secondSequence}\n+\n${'I' * 100}\n"
            new File("$outputDir/scope.tsv").text = 'taxid\n1729\n88456\n'
            new File("$outputDir/taxonomic_reference_db").mkdirs()
            new File("$outputDir/reference.fasta").text = ">first_target\n${firstSequence}\n>second_target\n${secondSequence}\n"
            assert ["pixi", "run", "deacon", "index", "build", "-k", "5", "-w", "1", "-e", "0", "-o", "$outputDir/baits.idx", "$outputDir/baits.fasta"].execute().waitFor() == 0
            assert ["pixi", "run", "--environment", "dev", "makeblastdb", "-dbtype", "nucl", "-parse_seqids", "-taxid", "1729", "-in", "$outputDir/reference.fasta", "-out", "$outputDir/taxonomic_reference_db/taxonomic"].execute().waitFor() == 0
        }
        when {
            workflow {
                """
                params.blast_shards = 2
                input[0] = Channel.of([[id: 'design'], [id: 'design__sample', design_id: 'design', metagenome_id: 'sample'], [file("$outputDir/reads.fastq")], file("$outputDir/baits.fasta"), file("$outputDir/baits.idx"), '88456', file("$outputDir/scope.tsv")])
                input[1] = Channel.value(file("$outputDir/taxonomic_reference_db"))
                input[2] = Channel.value(5)
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.calibration_reads.size() == 1
            assert file(workflow.out.calibration_reads[0][1]).readLines().size() == 3
            assert !file(workflow.out.calibration_reads[0][1]).readLines()[0].contains('classification')
            assert workflow.out.calibration_matches.size() == 1
            assert workflow.out.recommended_threshold.size() == 1
            assert file(workflow.out.recommended_threshold[0][1]).text == 'design_id\trecommended_threshold\ndesign\t1\n'
        }
    }

    test("withholds an empty read-query FASTA from query splitting and BLAST") {
        setup {
            new File("$outputDir/baits.fasta").text = '>candidate_kmer_000001\nACGTA\n'
            new File("$outputDir/reads.fastq").text = '@unrelated\nTTTTTTTTTT\n+\nIIIIIIIIII\n'
            new File("$outputDir/scope.tsv").text = 'taxid\n88456\n'
            new File("$outputDir/taxonomic_reference_db").mkdirs()
            assert ["pixi", "run", "deacon", "index", "build", "-k", "5", "-w", "1", "-e", "0", "-o", "$outputDir/baits.idx", "$outputDir/baits.fasta"].execute().waitFor() == 0
        }
        when {
            workflow {
                """
                input[0] = Channel.of([[id: 'design'], [id: 'design__sample', design_id: 'design', metagenome_id: 'sample'], [file("$outputDir/reads.fastq")], file("$outputDir/baits.fasta"), file("$outputDir/baits.idx"), '88456', file("$outputDir/scope.tsv")])
                input[1] = Channel.value(file("$outputDir/taxonomic_reference_db"))
                input[2] = Channel.value(5)
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.calibration_reads.size() == 0
            assert workflow.out.calibration_matches.size() == 0
            assert workflow.out.recommended_threshold.size() == 0
        }
    }

}
