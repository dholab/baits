nextflow_workflow {
    name "Taxonomic exact-match screening subworkflow"
    script "../subworkflows/local/taxonomic_exact_match_screening/main.nf"
    workflow "TAXONOMIC_EXACT_MATCH_SCREENING"

    test("broadcasts one shared database to two designs") {
        when {
            options '-stub-run'
            workflow {
                """
                input[0] = Channel.of(
                    [[id: 'design_a'], file(\"\$baseDir/tests/data/taxonomic_input_candidates.fasta\"), file(\"\$baseDir/tests/data/taxonomic_candidate_kmers.tsv\"), '88456', []],
                    [[id: 'design_b'], file(\"\$baseDir/tests/data/taxonomic_input_candidates.fasta\"), file(\"\$baseDir/tests/data/taxonomic_candidate_kmers.tsv\"), '88456', []]
                )
                input[1] = Channel.value(file(\"\$baseDir/tests/data/taxonomic_reference_db\"))
                input[2] = Channel.value(31)
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.hits.size() == 2
            assert workflow.out.manifest.size() == 2
            assert workflow.out.candidates.size() == 2
        }
    }

    test("withholds an empty selected-candidate FASTA from later processes") {
        setup {
            new File("$outputDir/reference.fasta").text = file("$baseDir/tests/data/taxonomic_input_candidates.fasta").text
            new File("$outputDir/database").mkdirs()
            assert ["pixi", "run", "--environment", "dev", "makeblastdb", "-dbtype", "nucl", "-parse_seqids", "-taxid", "1729", "-in", "$outputDir/reference.fasta", "-out", "$outputDir/database/reference"].execute().waitFor() == 0
        }
        when {
            workflow {
                """
                input[0] = Channel.of([[id: 'design'], file(\"\$baseDir/tests/data/taxonomic_input_candidates.fasta\"), file(\"\$baseDir/tests/data/taxonomic_candidate_kmers.tsv\"), '88456', []])
                input[1] = Channel.value(file("$outputDir/database"))
                input[2] = Channel.value(31)
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.manifest.size() == 1
            assert file(workflow.out.manifest[0][1]).text.count('off_target_match') == 2
            assert workflow.out.candidates.size() == 0
        }
    }
}
