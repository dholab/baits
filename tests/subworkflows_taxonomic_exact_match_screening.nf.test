nextflow_workflow {
    name "Taxonomic exact-match screening subworkflow"
    script "../subworkflows/local/taxonomic_exact_match_screening/main.nf"
    workflow "TAXONOMIC_EXACT_MATCH_SCREENING"

    test("broadcasts one shared database to two designs") {
        when {
            options '-stub-run'
            workflow {
                """
                input[0] = Channel.of(
                    [[id: 'design_a'], file(\"\$baseDir/tests/data/taxonomic_input_candidates.fasta\"), file(\"\$baseDir/tests/data/taxonomic_candidate_kmers.tsv\"), '88456'],
                    [[id: 'design_b'], file(\"\$baseDir/tests/data/taxonomic_input_candidates.fasta\"), file(\"\$baseDir/tests/data/taxonomic_candidate_kmers.tsv\"), '88456']
                )
                input[1] = Channel.value(file(\"\$baseDir/tests/data/taxonomic_reference_db\"))
                input[2] = Channel.value(31)
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.hits.size() == 2
            assert workflow.out.decisions.size() == 2
            assert workflow.out.manifest.size() == 2
            assert workflow.out.candidates.size() == 2
            assert workflow.out.reference_database_report.size() == 2
        }
    }
}
